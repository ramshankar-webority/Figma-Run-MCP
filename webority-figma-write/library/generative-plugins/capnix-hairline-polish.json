 255, b: parseInt(h.slice(5, 7), 16) / 255 });\nconst grad = (a, b) => [{ type: \"GRADIENT_LINEAR\", gradientTransform: [[0, 1, 0], [-1, 0, 1]], gradientStops: [{ position: 0, color: { ...hex(a), a: 1 } }, { position: 1, color: { ...hex(b), a: 1 } }] }];\nconst isRed = p => p && p.type === \"SOLID\" && p.color.r > 0.9 && p.color.g < 0.4;\nconst isWhitish = p => p && p.type === \"SOLID\" && p.color.r > 0.95 && p.color.g > 0.9 && p.color.b > 0.9;\nconst stats = [];\nfor (const f of sec.children.filter(n => n.type === \"FRAME\")) {\n  f.children.filter(n => n.name === \"Illustration shadow\").forEach(n => n.remove());\n  const ill = f.children.find(n => n.name.startsWith(\"Illustration · hairline\"));\n  if (!ill) continue;\n  const vecs = ill.findAll(n => n.type === \"VECTOR\" && Array.isArray(n.fills) && n.fills.length && n.fills[0].type === \"SOLID\");\n  const area = n => n.width * n.height;\n  const base = vecs.slice().sort((a, b) => area(b) - area(a))[0];\n  let hi = 0, plain = 0;\n  for (const v of vecs) {\n    const red = isRed(v.strokes && v.strokes[0]) || (v.fills[0].color.r > 0.99 && v.fills[0].color.g < 0.97 && v.fills[0].color.b < 0.95);\n    if (!red && !isWhitish(v.fills[0])) continue;\n    if (red) { v.fills = grad(\"#fff4f1\", \"#ffcfc6\"); hi++; }\n    else if (v === base) v.fills = grad(\"#f6f8fc\", \"#d9e0ec\");\n    else { v.fills = grad(\"#ffffff\", \"#e3e8f2\"); plain++; }\n  }\n  const sh = figma.createEllipse();\n  sh.name = \"Illustration shadow\";\n  const w = ill.width * 0.82, h = Math.max(36, ill.height * 0.11);\n  sh.resize(w, h);\n  sh.fills = [{ type: \"SOLID\", color: hex(\"#071437\"), opacity: 0.10 }];\n  sh.effects = [{ type: \"LAYER_BLUR\", blurType: \"NORMAL\", radius: 30, visible: true }];\n  f.insertChild(f.children.indexOf(ill), sh);\n  sh.x = Math.round(ill.x + (ill.width - w) / 2); sh.y = Math.round(ill.y + ill.height - h * 0.62);\n  stats.push({ slide: f.name, hi, plain, base: !!base });\n}\nreturn stats;\n",
